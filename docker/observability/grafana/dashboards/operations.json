      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mp_kafka_log_end_offset[1m])",
          "legendFormat": "{{source}} {{job}} {{topic}} {{group}} {{kind}} {{state}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
