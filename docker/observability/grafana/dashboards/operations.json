{
  "uid": "marketpulse-operations",
  "title": "MarketPulse 360 \u2014 Operations",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "marketpulse",
    "mp09"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Target/source availability",
      "datasource": {
        "type": "prometheus",
        "uid": "marketpulse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up or mp_source_up",
          "legendFormat": "{{source}} {{job}} {{topic}} {{group}} {{kind}} {{state}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "marketpulse-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(mp_api_requests_total[1m]))",
          "legendFormat": "{{source}} {{job}} {{topic}} {{group}} {{kind}} {{state}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "marketpulse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(mp_api_request_seconds_bucket[1m])))",
          "legendFormat": "{{source}} {{job}} {{topic}} {{group}} {{kind}} {{state}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        },
        "overrides": []
      }
    },
    {
