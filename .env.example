# Copy to .env, then fill both password fields with independently generated values.
# .env is ignored by Git and excluded from Docker build contexts. Never share or
# reuse production credentials here. Empty fields intentionally fail validation.
LAKEHOUSE_POSTGRES_USER=nessie
LAKEHOUSE_POSTGRES_PASSWORD=
MINIO_ROOT_USER=marketpulse
# MinIO requires at least 8 characters. For each password: openssl rand -hex 24
MINIO_ROOT_PASSWORD=
