# Copy to .env, then fill password fields with independently generated values.
# .env is ignored by Git and excluded from Docker build contexts. Never share or
# reuse production credentials here. Empty fields intentionally fail validation.
LAKEHOUSE_POSTGRES_USER=nessie
LAKEHOUSE_POSTGRES_PASSWORD=
MINIO_ROOT_USER=marketpulse
# MinIO requires at least 8 characters. For each password: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# MP-05 batch / serving. Initialize only missing passwords with:
# PYTHONPATH=src python -m marketpulse_batch.local_env --path .env
CLICKHOUSE_USER=marketpulse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HOST_PORT=8123
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_PASSWORD=
DAGSTER_HOST_PORT=3000

# MP-06 application; initialize only missing password explicitly:
# PYTHONPATH=src python -m marketpulse_app.local_env --path .env
APP_POSTGRES_USER=marketpulse_app
APP_POSTGRES_DB=marketpulse_app
APP_POSTGRES_PASSWORD=
API_HOST_PORT=8000
WEB_HOST_PORT=3100

# MP-09 explicit ops_setup secrets; exact public browser origin for CSRF.
APP_PUBLIC_ORIGIN=http://localhost:43100
APP_COOKIE_SECURE=false
PROMETHEUS_HOST_PORT=49090
GRAFANA_HOST_PORT=43001
