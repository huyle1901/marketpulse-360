{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketpulse:kafka:email-events:v1",
  "title": "MarketPulse email event v1",
  "type": "object",
  "required": ["event_id", "event_name", "event_time", "ingested_at", "source", "schema_version", "customer_id", "anonymous_id", "session_id", "campaign_id", "platform_campaign_id", "click_id", "consent_analytics", "is_late", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_name": {"enum": ["email_sent", "email_delivered", "email_opened", "email_clicked", "email_unsubscribed"]},
    "event_time": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "source": {"const": "email"},
    "schema_version": {"const": 1},
    "customer_id": {"type": "string"},
    "anonymous_id": {"type": ["string", "null"]},
    "session_id": {"type": "string"},
    "campaign_id": {"type": ["string", "null"]},
    "platform_campaign_id": {"type": ["string", "null"]},
    "click_id": {"type": ["string", "null"]},
    "consent_analytics": {"type": "boolean"},
    "is_late": {"type": "boolean"},
    "payload": {"type": "object", "required": ["message_id", "lifecycle_campaign_id", "destination_url"]}
  },
  "additionalProperties": false
}
